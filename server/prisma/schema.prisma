// ──────────────────────────────────────────────────────
// Nexora — Prisma Schema
// Database: PostgreSQL (Supabase)
// ──────────────────────────────────────────────────────

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

// ──────────────────────────────────────────────────────
// ENUMS
// ──────────────────────────────────────────────────────

enum UserRole {
  student
  mentor
  admin
}

enum Proficiency {
  beginner
  intermediate
  advanced
  expert
}

enum AvailabilityStatus {
  available_for_team
  looking_for_project
  hiring
  not_available
}

enum ActivityAction {
  profile_updated
  skill_added
  skill_removed
  team_joined
  team_created
  project_created
  project_updated
  task_completed
  connection_made
  session_completed
}

enum TeamType {
  project
  hackathon
  startup
  research
  competition
}

enum TeamStatus {
  recruiting
  active
  completed
  archived
}

enum TeamMemberRole {
  owner
  admin
  member
}

enum JoinRequestStatus {
  pending
  accepted
  rejected
}

enum ProjectStatus {
  planning
  in_progress
  completed
  on_hold
}

enum TaskStatus {
  todo
  in_progress
  in_review
  done
}

enum TaskPriority {
  low
  medium
  high
  critical
}

enum ConversationType {
  direct
  team
  project
}

enum MessageType {
  text
  image
  file
  system
}

enum SkillExchangeStatus {
  requested
  accepted
  in_progress
  completed
  cancelled
}

enum EventType {
  hackathon
  workshop
  competition
  meetup
  webinar
}

enum NotificationType {
  team_invite
  join_request
  message
  skill_request
  event_reminder
  connection_request
  system
}

enum ConnectionStatus {
  pending
  accepted
  rejected
}

// ──────────────────────────────────────────────────────
// MODELS
// ──────────────────────────────────────────────────────

/// User profile — extends Supabase auth.users via matching UUID
model Profile {
  id                 String             @id @default(uuid()) @db.Uuid
  fullName           String             @map("full_name") @db.VarChar(100)
  username           String             @unique @db.VarChar(50)
  avatarUrl          String?            @map("avatar_url")
  bio                String?
  department         String             @db.VarChar(100)
  year               Int                @db.SmallInt
  college            String?            @db.VarChar(200)
  githubUrl          String?            @map("github_url")
  portfolioUrl       String?            @map("portfolio_url")
  linkedinUrl        String?            @map("linkedin_url")
  resumeUrl          String?            @map("resume_url")
  interests          String[]           @default([])
  role               UserRole           @default(student)
  isAvailable        Boolean            @default(true) @map("is_available")
  availabilityStatus AvailabilityStatus @default(available_for_team) @map("availability_status")
  usernameChangedAt  DateTime?          @map("username_changed_at") @db.Timestamptz()
  createdAt          DateTime           @default(now()) @map("created_at") @db.Timestamptz()
  updatedAt          DateTime           @default(now()) @updatedAt @map("updated_at") @db.Timestamptz()

  // Relations
  skills                UserSkill[]
  teamMemberships       TeamMember[]
  joinRequests          TeamJoinRequest[]
  createdTeams          Team[]                 @relation("TeamCreator")
  createdProjects       Project[]              @relation("ProjectCreator")
  assignedTasks         ProjectTask[]          @relation("TaskAssignee")
  conversationMembers   ConversationParticipant[]
  sentMessages          Message[]
  mentorSessions        SkillExchangeSession[] @relation("Mentor")
  menteeSessions        SkillExchangeSession[] @relation("Mentee")
  createdEvents         Event[]                @relation("EventCreator")
  eventBookmarks        EventBookmark[]
  notifications         Notification[]
  sentConnections       UserConnection[]       @relation("ConnectionRequester")
  receivedConnections   UserConnection[]       @relation("ConnectionReceiver")
  activityLogs          ActivityLog[]

  @@index([role, isAvailable])
  @@index([department, year])
  @@map("profiles")
}

/// Master skill catalog
model Skill {
  id       String @id @default(uuid()) @db.Uuid
  name     String @unique @db.VarChar(50)
  category String @db.VarChar(50)

  // Relations
  userSkills          UserSkill[]
  teamRequiredSkills  TeamRequiredSkill[]
  exchangeSessions    SkillExchangeSession[]

  @@map("skills")
}

/// Junction: user ↔ skill with proficiency
model UserSkill {
  userId      String      @map("user_id") @db.Uuid
  skillId     String      @map("skill_id") @db.Uuid
  proficiency Proficiency @default(beginner)

  user  Profile @relation(fields: [userId], references: [id], onDelete: Cascade)
  skill Skill   @relation(fields: [skillId], references: [id], onDelete: Cascade)

  @@id([userId, skillId])
  @@map("user_skills")
}

/// Teams for projects, hackathons, startups, etc.
model Team {
  id          String     @id @default(uuid()) @db.Uuid
  name        String     @db.VarChar(100)
  description String?
  avatarUrl   String?    @map("avatar_url")
  type        TeamType
  status      TeamStatus @default(recruiting)
  maxMembers  Int        @default(5) @map("max_members") @db.SmallInt
  isPublic    Boolean    @default(true) @map("is_public")
  createdBy   String     @map("created_by") @db.Uuid
  createdAt   DateTime   @default(now()) @map("created_at") @db.Timestamptz()
  updatedAt   DateTime   @default(now()) @updatedAt @map("updated_at") @db.Timestamptz()

  // Relations
  creator        Profile              @relation("TeamCreator", fields: [createdBy], references: [id])
  members        TeamMember[]
  joinRequests   TeamJoinRequest[]
  requiredSkills TeamRequiredSkill[]
  projects       Project[]
  conversations  Conversation[]

  @@map("teams")
}

/// Team membership with role
model TeamMember {
  teamId   String         @map("team_id") @db.Uuid
  userId   String         @map("user_id") @db.Uuid
  role     TeamMemberRole @default(member)
  joinedAt DateTime       @default(now()) @map("joined_at") @db.Timestamptz()

  team Team    @relation(fields: [teamId], references: [id], onDelete: Cascade)
  user Profile @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([teamId, userId])
  @@map("team_members")
}

/// Request to join a team
model TeamJoinRequest {
  id        String            @id @default(uuid()) @db.Uuid
  teamId    String            @map("team_id") @db.Uuid
  userId    String            @map("user_id") @db.Uuid
  message   String?
  status    JoinRequestStatus @default(pending)
  createdAt DateTime          @default(now()) @map("created_at") @db.Timestamptz()

  team Team    @relation(fields: [teamId], references: [id], onDelete: Cascade)
  user Profile @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("team_join_requests")
}

/// Skills a team is looking for
model TeamRequiredSkill {
  teamId  String @map("team_id") @db.Uuid
  skillId String @map("skill_id") @db.Uuid

  team  Team  @relation(fields: [teamId], references: [id], onDelete: Cascade)
  skill Skill @relation(fields: [skillId], references: [id], onDelete: Cascade)

  @@id([teamId, skillId])
  @@map("team_required_skills")
}

/// Project workspace
model Project {
  id          String        @id @default(uuid()) @db.Uuid
  teamId      String?       @map("team_id") @db.Uuid
  title       String        @db.VarChar(200)
  description String?
  status      ProjectStatus @default(planning)
  repoUrl     String?       @map("repo_url")
  liveUrl     String?       @map("live_url")
  createdBy   String        @map("created_by") @db.Uuid
  createdAt   DateTime      @default(now()) @map("created_at") @db.Timestamptz()
  updatedAt   DateTime      @default(now()) @updatedAt @map("updated_at") @db.Timestamptz()

  // Relations
  creator       Profile        @relation("ProjectCreator", fields: [createdBy], references: [id])
  team          Team?          @relation(fields: [teamId], references: [id], onDelete: SetNull)
  tasks         ProjectTask[]
  conversations Conversation[]

  @@map("projects")
}

/// Task within a project
model ProjectTask {
  id          String       @id @default(uuid()) @db.Uuid
  projectId   String       @map("project_id") @db.Uuid
  title       String       @db.VarChar(200)
  description String?
  status      TaskStatus   @default(todo)
  priority    TaskPriority @default(medium)
  assignedTo  String?      @map("assigned_to") @db.Uuid
  dueDate     DateTime?    @map("due_date") @db.Date
  createdAt   DateTime     @default(now()) @map("created_at") @db.Timestamptz()
  updatedAt   DateTime     @default(now()) @updatedAt @map("updated_at") @db.Timestamptz()

  project  Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  assignee Profile? @relation("TaskAssignee", fields: [assignedTo], references: [id], onDelete: SetNull)

  @@map("project_tasks")
}

/// Chat conversation (direct, team, or project)
model Conversation {
  id        String           @id @default(uuid()) @db.Uuid
  type      ConversationType
  teamId    String?          @map("team_id") @db.Uuid
  projectId String?          @map("project_id") @db.Uuid
  createdAt DateTime         @default(now()) @map("created_at") @db.Timestamptz()

  team         Team?                       @relation(fields: [teamId], references: [id], onDelete: SetNull)
  project      Project?                    @relation(fields: [projectId], references: [id], onDelete: SetNull)
  participants ConversationParticipant[]
  messages     Message[]

  @@map("conversations")
}

/// Conversation membership
model ConversationParticipant {
  conversationId String   @map("conversation_id") @db.Uuid
  userId         String   @map("user_id") @db.Uuid
  joinedAt       DateTime @default(now()) @map("joined_at") @db.Timestamptz()
  lastReadAt     DateTime? @map("last_read_at") @db.Timestamptz()

  conversation Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  user         Profile      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([conversationId, userId])
  @@map("conversation_participants")
}

/// Chat message
model Message {
  id             String      @id @default(uuid()) @db.Uuid
  conversationId String      @map("conversation_id") @db.Uuid
  senderId       String      @map("sender_id") @db.Uuid
  content        String
  type           MessageType @default(text)
  fileUrl        String?     @map("file_url")
  isEdited       Boolean     @default(false) @map("is_edited")
  createdAt      DateTime    @default(now()) @map("created_at") @db.Timestamptz()

  conversation Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  sender       Profile      @relation(fields: [senderId], references: [id], onDelete: Cascade)

  @@map("messages")
}

/// Skill exchange / mentoring session
model SkillExchangeSession {
  id          String              @id @default(uuid()) @db.Uuid
  mentorId    String              @map("mentor_id") @db.Uuid
  menteeId    String              @map("mentee_id") @db.Uuid
  skillId     String              @map("skill_id") @db.Uuid
  status      SkillExchangeStatus @default(requested)
  description String?
  scheduledAt DateTime?           @map("scheduled_at") @db.Timestamptz()
  rating      Int?                @db.SmallInt
  feedback    String?
  createdAt   DateTime            @default(now()) @map("created_at") @db.Timestamptz()

  mentor Profile @relation("Mentor", fields: [mentorId], references: [id], onDelete: Cascade)
  mentee Profile @relation("Mentee", fields: [menteeId], references: [id], onDelete: Cascade)
  skill  Skill   @relation(fields: [skillId], references: [id], onDelete: Cascade)

  @@map("skill_exchange_sessions")
}

/// Events, hackathons, workshops
model Event {
  id              String    @id @default(uuid()) @db.Uuid
  title           String    @db.VarChar(200)
  description     String?
  type            EventType
  organizer       String?   @db.VarChar(200)
  bannerUrl       String?   @map("banner_url")
  location        String?   @db.VarChar(200)
  isOnline        Boolean   @default(false) @map("is_online")
  registrationUrl String?   @map("registration_url")
  startDate       DateTime  @map("start_date") @db.Timestamptz()
  endDate         DateTime  @map("end_date") @db.Timestamptz()
  createdBy       String    @map("created_by") @db.Uuid
  createdAt       DateTime  @default(now()) @map("created_at") @db.Timestamptz()

  creator   Profile         @relation("EventCreator", fields: [createdBy], references: [id])
  bookmarks EventBookmark[]

  @@map("events")
}

/// Event bookmark
model EventBookmark {
  eventId   String   @map("event_id") @db.Uuid
  userId    String   @map("user_id") @db.Uuid
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz()

  event Event   @relation(fields: [eventId], references: [id], onDelete: Cascade)
  user  Profile @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([eventId, userId])
  @@map("event_bookmarks")
}

/// Notification
model Notification {
  id            String           @id @default(uuid()) @db.Uuid
  userId        String           @map("user_id") @db.Uuid
  type          NotificationType
  title         String           @db.VarChar(200)
  body          String?
  referenceType String?          @map("reference_type") @db.VarChar(50)
  referenceId   String?          @map("reference_id") @db.Uuid
  isRead        Boolean          @default(false) @map("is_read")
  createdAt     DateTime         @default(now()) @map("created_at") @db.Timestamptz()

  user Profile @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("notifications")
}

/// User-to-user connection
model UserConnection {
  id          String           @id @default(uuid()) @db.Uuid
  requesterId String           @map("requester_id") @db.Uuid
  receiverId  String           @map("receiver_id") @db.Uuid
  status      ConnectionStatus @default(pending)
  createdAt   DateTime         @default(now()) @map("created_at") @db.Timestamptz()

  requester Profile @relation("ConnectionRequester", fields: [requesterId], references: [id], onDelete: Cascade)
  receiver  Profile @relation("ConnectionReceiver", fields: [receiverId], references: [id], onDelete: Cascade)

  @@unique([requesterId, receiverId])
  @@map("user_connections")
}

/// Activity log for tracking user actions (heatmap, timeline)
model ActivityLog {
  id          String         @id @default(uuid()) @db.Uuid
  userId      String         @map("user_id") @db.Uuid
  action      ActivityAction
  description String?
  metadata    Json?          @db.JsonB
  createdAt   DateTime       @default(now()) @map("created_at") @db.Timestamptz()

  user Profile @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
  @@map("activity_logs")
}
